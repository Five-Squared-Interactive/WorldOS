{
  "name": "@worldos/server",
  "version": "0.1.0",
  "description": "WorldOS Core Server - plugin loader, health monitoring, MQTT bus, embedded Mosquitto broker",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mqtt": "^4.3.8",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aedes": "^0.51.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
