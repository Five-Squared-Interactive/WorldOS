{
  "name": "@worldos/cli",
  "version": "0.1.0",
  "description": "WorldOS Command-Line Interface",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wos": "./bin/run.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "oclif": {
    "bin": "wos",
    "dirname": "wos",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topicSeparator": " "
  },
  "dependencies": {
    "@oclif/core": "^4.8.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.16",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
